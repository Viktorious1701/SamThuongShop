// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Story 1.4 — Customer accounts (Auth.js v5, Credentials provider, JWT
// session). `role` defaults to "customer" now so Story 1.5 can add the
// operator principal without a schema migration churn.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("customer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[] // Story 3.2 — a signed-in customer's orders
}

// --- Epic 2, Story 2.1 — Product catalog ---------------------------------
// First relational tables. Bilingual content is stored per-locale (vi/en)
// on the row itself (AD-7 — content is data, not next-intl message keys);
// prices are integer VND (AD-5). Only lib/server touches these (AD-2).

// A Variant is EITHER a Physical Print (size) OR a Digital Download (tier)
// — this discriminator drives fulfilment downstream (AD-8: shipping iff any
// physical line; COD iff no digital line; digital line qty fixed to 1).
enum VariantFormat {
  PRINT
  DIGITAL
}

// A Product is one of Sam Thuong's bird images, sold via one or more
// Variants. Publish/unpublish controls storefront visibility (FR-19);
// unpublished rows are preserved in admin.
model Product {
  id            String   @id @default(cuid())
  slug          String   @unique // stable storefront URL key (Epic 2.4)
  nameVi        String
  nameEn        String
  descriptionVi String?
  descriptionEn String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  variants    ProductVariant[]
  images      ProductImage[]
  collections Collection[] // Story 2.3 — many-to-many
}

// A specific purchasable form of a Product with its own integer-VND price.
// `label` is operator-defined free text (the print size or digital tier) —
// OQ-3 (concrete options) stays open, so the model takes arbitrary labels
// rather than a fixed enum. Digital-only columns hold the private original;
// `previewKey` is populated later by Story 2.2 (watermarked preview).
model ProductVariant {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  format    VariantFormat
  label     String
  priceVnd  Int
  position  Int           @default(0)

  // Digital Download only — the sellable original in PRIVATE R2 (AD-15,
  // non-derivable key). Never served before payment (AD-6, Epic 3).
  originalKey      String?
  originalFilename String?
  contentType      String?
  sizeBytes        Int?
  previewKey       String? // Story 2.2 — watermarked preview (public)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderLines OrderLine[] // Story 3.2 — soft link (order history never live-joins)

  @@index([productId])
}

// A public display image for a Product. `key` addresses an object in the
// PUBLIC R2 bucket; the public URL is built by lib/server/storage.ts.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// --- Story 2.3 — Collections + store settings ----------------------------

// A curated grouping of Products (by species, habitat, theme). Many-to-many
// with Product — a photo can appear in several collections. Storefront
// filtering by Collection lands in Story 2.4.
model Collection {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameVi        String
  nameEn        String
  descriptionVi String?
  descriptionEn String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[] // implicit m-n join (_CollectionToProduct)
}

// Singleton store settings (one row, fixed id "store"). Holds the flat
// shipping fee (integer VND, AD-5) the checkout applies to Physical Print
// Orders (FR-20 / FR-7). v1 is a single flat fee; tiered rating deferred.
model StoreSetting {
  id             String   @id @default("store")
  shippingFeeVnd Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// --- Epic 3, Story 3.2 — Orders ------------------------------------------
// The Order is the transactional aggregate (AD-3). Fixed status machine:
// PENDING_PAYMENT → PAID → PROCESSING → SHIPPED → COMPLETED, plus CANCELLED.
// COD enters at PROCESSING (Story 3.4). Money is decomposed integer VND and
// recomputed server-side (AD-10); shipping is an Order field, not a line.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model Order {
  id        String      @id @default(cuid())
  reference String      @unique // short uppercase, for guest lookup (AD-14)
  status    OrderStatus @default(PENDING_PAYMENT)
  locale    String // buyer locale at creation (for snapshots + email)

  // Purchaser: always an email (guest lookup, AD-14); userId set when signed in.
  customerEmail String
  userId        String?
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Decomposed money (AD-10) — grandTotalVnd is the only amount a provider sees.
  subtotalVnd    Int
  shippingFeeVnd Int @default(0)
  discountVnd    Int @default(0)
  grandTotalVnd  Int

  // Shipping (nullable — only when the order contains a Physical Print, AD-8).
  shipName    String?
  shipPhone   String?
  shipAddress String?
  shipCity    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines OrderLine[]

  @@index([userId])
}

// A purchased line. Snapshots the buy (AD-11) — unit price, format, and the
// buyer-locale product name — so operator edits never re-price/relabel
// history. `variantId` is a SOFT link (SetNull): history never live-joins.
model OrderLine {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName  String
  format       VariantFormat
  unitPriceVnd Int
  qty          Int
  lineTotalVnd Int

  @@index([orderId])
}
