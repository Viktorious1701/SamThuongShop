# Copy to .env and fill in real values. Never commit .env or real secrets.
# Secrets are read from environment variables only — never bundled into
# client code (Architecture Spine — Consistency Conventions: Secrets & config).

# --- Database (this story) ---------------------------------------------
# Supabase Postgres, Singapore (ap-southeast-1) region.
# DATABASE_URL — app runtime: the TRANSACTION pooler (pgBouncer, port 6543).
#   Append ?pgbouncer=true&connection_limit=1 so the driver adapter behaves.
# DIRECT_URL — migrations, DDL and `db:seed` only: the DIRECT/session
#   connection (port 5432). Read by prisma.config.ts (pgBouncer can't run DDL).
DATABASE_URL="postgresql://user:password@host:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# --- Auth (Story 1.4 — Auth.js v5) --------------------------------------
AUTH_SECRET=""

# --- Operator seed (Story 1.5 — no self-serve operator signup) ----------
# Read by prisma/seed.ts. Dev defaults if unset: admin@samthuong.shop /
# Operator123! — override these for any non-local environment.
OPERATOR_EMAIL=""
OPERATOR_PASSWORD=""

# --- Email (later stories — Resend) -------------------------------------
RESEND_API_KEY=""

# --- Object storage (Story 2.1 — Cloudflare R2, S3-compatible API) ------
# Two buckets: PUBLIC holds display images + previews (viewable); PRIVATE
# holds sellable Digital Download originals (never served before payment).
# Uploads go browser → R2 via presigned PUT, so both buckets need a CORS
# policy allowing PUT+GET from your dev/prod origin.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PRIVATE="samthuong-private"
R2_BUCKET_PUBLIC="samthuong-public"
# Optional endpoint override; defaults to https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
# Public base URL of the PUBLIC bucket (r2.dev subdomain or custom domain),
# used to build image src + the next/image remote pattern. No trailing slash.
R2_PUBLIC_BASE_URL=""

# --- Payments (later stories — payOS / VietQR) ---------------------------
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
