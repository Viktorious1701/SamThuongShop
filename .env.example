# Copy to .env and fill in real values. Never commit .env or real secrets.
# Secrets are read from environment variables only — never bundled into
# client code (Architecture Spine — Consistency Conventions: Secrets & config).

# --- Database (this story) ---------------------------------------------
# Neon Postgres connection string, Singapore (ap-southeast-1) region.
# Use a Neon branch for local dev; production points at the Neon `sin1` project.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (Story 1.4 — Auth.js v5) --------------------------------------
AUTH_SECRET=""

# --- Email (later stories — Resend) -------------------------------------
RESEND_API_KEY=""

# --- Object storage (later stories — Cloudflare R2, S3-compatible API) --
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PRIVATE=""
R2_BUCKET_PUBLIC=""
R2_ENDPOINT=""

# --- Payments (later stories — payOS / VietQR) ---------------------------
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
